# Server
NODE_ENV=development
PORT=3000

# Database Configuration
# SECURITY WARNING: Change all database passwords before deploying to production!
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=campusvote_db

# Application Database User (non-superuser)
POSTGRES_APP_USER=campusvote_app
POSTGRES_APP_PASSWORD=CHANGE_ME_DIFFERENT_STRONG_PASSWORD_HERE

# Application Database Connection
DATABASE_URL="postgresql://${POSTGRES_APP_USER}:${POSTGRES_APP_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public"

# Migration Database Connection
MIGRATION_DATABASE_URL="postgresql://${POSTGRES_SUPERUSER}:${POSTGRES_SUPERUSER_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public"

# JWT
# OBLIGATORIO: Generar una clave única de al menos 32 caracteres.
# Ejecuta en terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
TOTP_ENCRYPTION_KEY=
AUDIT_SECRET_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173,https://campusvote-front.onrender.com

# Security
BCRYPT_ROUNDS=12

# App
APP_NAME=CampusVote
APP_VERSION=1.0.0

# URLs públicas / Swagger
APP_URL=http://localhost:3000
STAGE_API_URL=
PROD_API_URL=
SWAGGER_ENABLED=true

# Rate limit global (peticiones por IP por ventana de 15 min)
# En producción subirlo (p. ej. 1000). Por defecto 100.
RATE_LIMIT_MAX_REQUESTS=100

# Backups automáticos (pg_dump) — activar en producción con BACKUP_ENABLED=true
BACKUP_ENABLED=false
BACKUP_DIR=
BACKUP_CRON_HOUR=2
BACKUP_KEEP=7
PG_DUMP_PATH=

# Firebase Storage (opcional; no es autenticación)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# En Render conservar \n literalmente o configurar el secreto con saltos de línea.
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
UPLOAD_STORAGE_DRIVER=local

# Email — Gmail API (OAuth2)
# Flujo:
#   1. Crear OAuth Client (Web application) en Google Cloud Console
#      (ver microtarea MT00 en workflow/semana-37-2026).
#   2. Habilitar Gmail API en el mismo proyecto.
#   3. Generar el refresh token una vez:
#        node scripts/get-gmail-refresh-token.js
#   4. Pegar las 5 variables en este archivo y en el dashboard de Render.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/auth/google/callback
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

# Frontend Links
FRONTEND_URL=http://localhost:5173,https://campusvote-front.onrender.com

# Tests
TEST_EMAIL=tu-correo@ejemplo.com