# Server
NODE_ENV=development
PORT=3000

# Database — Docker puerto 5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/campusvote_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=*

# Security
BCRYPT_ROUNDS=12

# App
APP_NAME=CampusVote
APP_VERSION=1.0.0

# Email — Mailtrap inbox SMTP (sendVerification / sendReset)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp-mailtrap
SMTP_PASS=tu-password-smtp-mailtrap
SMTP_FROM=noreply@campusvote.com

# links verify-email / reset-password — aún sin frontend, token lo paso por Swagger
FRONTEND_URL=http://localhost:5173

# npm run test:email
TEST_EMAIL=tu-correo@ejemplo.com
