# Server
NODE_ENV=development
PORT=3000

# Database Configuration
# SECURITY WARNING: Change all database passwords before deploying to production!
# Use strong, randomly generated passwords and store them securely (e.g., in a secrets manager)

# PostgreSQL Superuser (for migrations and administrative tasks only)
# DO NOT use the superuser account for the application runtime connection
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=campusvote_db

# Application Database User (non-superuser with limited privileges)
# This account should be used by the application for runtime operations
POSTGRES_APP_USER=campusvote_app
POSTGRES_APP_PASSWORD=CHANGE_ME_DIFFERENT_STRONG_PASSWORD_HERE

# Application Database Connection
# Uses the non-superuser application account for runtime operations
# Docker binds to localhost:5433 only (not exposed to external networks)
DATABASE_URL="postgresql://${POSTGRES_APP_USER}:${POSTGRES_APP_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public"

# Migration Database Connection (uses superuser for schema changes)
# Only use this for running migrations, not for application runtime
MIGRATION_DATABASE_URL="postgresql://${POSTGRES_SUPERUSER}:${POSTGRES_SUPERUSER_PASSWORD}@localhost:5433/${POSTGRES_DB}?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=*

# Security
BCRYPT_ROUNDS=12

# App
APP_NAME=CampusVote
APP_VERSION=1.0.0

# Email — Mailtrap inbox SMTP (sendVerification / sendReset)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp-mailtrap
SMTP_PASS=tu-password-smtp-mailtrap
SMTP_FROM=noreply@campusvote.com

# links verify-email / reset-password — aún sin frontend, token lo paso por Swagger
FRONTEND_URL=http://localhost:5173

# npm run test:email
TEST_EMAIL=tu-correo@ejemplo.com
