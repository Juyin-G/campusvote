# Server
NODE_ENV=development
PORT=3000

# Database — Docker puerto 5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/campusvote_db?schema=public"

# JWT
# IMPORTANTE: JWT_SECRET es OBLIGATORIO en todos los entornos (desarrollo, pruebas, producción)
# Debe tener al menos 32 caracteres y ser criptográficamente seguro
# Genere uno único con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA use valores predeterminados o de ejemplo en producción
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-must-be-at-least-32-chars
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=*

# Security
BCRYPT_ROUNDS=12

# App
APP_NAME=CampusVote
APP_VERSION=1.0.0

# Email — Mailtrap inbox SMTP (sendVerification / sendReset)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=tu-usuario-smtp-mailtrap
SMTP_PASS=tu-password-smtp-mailtrap
SMTP_FROM=noreply@campusvote.com

# links verify-email / reset-password — aún sin frontend, token lo paso por Swagger
FRONTEND_URL=http://localhost:5173

# npm run test:email
TEST_EMAIL=tu-correo@ejemplo.com
