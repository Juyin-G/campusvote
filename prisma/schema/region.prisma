// REGIONES DE UNA ORGANIZACIÓN (multi-sede).
//
// Estructura:
//   Organization ── Region ── OrganizationSite
//                       └──────── User (rol = ADMIN, scopeLevel = REGION)
//
// Decisiones:
//   * region_id en organization_sites y users es NULL: una organización
//     puede operar sin regiones (modo legacy / single-tenant simple).
//   * FK a Organization con ON DELETE CASCADE: la región muere con su org.
//   * UNIQUE (organization_id, code) para evitar duplicados.

model Region {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(30)
  name           String   @db.VarChar(150)
  description    String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sites       OrganizationSite[]
  users       User[]              @relation("UserRegion")

  @@unique([organizationId, code])
  @@index([organizationId], map: "idx_regions_organization")
  @@map("regions")
}
