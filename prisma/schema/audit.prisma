enum AuditActionType {
  LOGIN
  VERIFY_2FA
  ACCESS_DENIED
  CAST_FAIR_VOTE
  FAIR_VOTE_ATTEMPT_DENIED
  RUBRIC_CHECKLIST_FINALIZED
  PROJECT_LIKED
  PROJECT_COMMENTED
  PROJECT_LIKE_MILESTONE

  @@map("audit_action_type")
}

model AuditLog {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sequenceNum  BigInt          @unique @default(autoincrement()) @map("sequence_num")
  actorId      String?         @map("actor_id") @db.Uuid
  action       AuditActionType
  timestamp    DateTime        @default(now()) @db.Timestamptz(6)
  ipAddress    String?         @map("ip_address") @db.Inet
  metadata     Json            @default("{}")
  previousHash String          @default("") @map("previous_hash") @db.VarChar(64)
  currentHash  String          @default("") @map("current_hash") @db.VarChar(64)
  signature    String          @default("")

  // Relaciones
  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([action, timestamp(sort: Desc)], map: "idx_audit_logs_action_timestamp")
  @@index([actorId, timestamp(sort: Desc)], map: "idx_audit_logs_actor_timestamp")
  @@index([timestamp(sort: Desc)], map: "idx_audit_logs_timestamp_desc")
  @@map("audit_logs")
}