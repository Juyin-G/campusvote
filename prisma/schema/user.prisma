// ENUMS

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  SUPERADMIN
  JURY

  @@map("user_role")
}

// Alcance administrativo del usuario (solo aplica a rol = ADMIN).
// STUDENT/TEACHER/JURY/SUPERADMIN deben mantener scope_level = NULL.
enum UserScopeLevel {
  ORG
  REGION
  SITE

  @@map("user_scope_level")
}

enum UserStatus {
  PENDING
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

enum AuthProviderType {
  LOCAL

  @@map("auth_provider_type")
}

enum AvatarType {
  DEFAULT_DICEBEAR
  UPLOADED
  GRAVATAR

  @@map("avatar_type")
}

// Perú: Documento Nacional de Identidad / Carnet de Extranjería
enum DocumentType {
  DNI
  CE

  @@map("document_type")
}

// MODELOS

model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // ------------------------------------------------------
  // AUTENTICACIÓN
  // ------------------------------------------------------
  password     String?          @db.VarChar(255)
  authProvider AuthProviderType @default(LOCAL) @map("auth_provider")

  // ------------------------------------------------------
  // SESIÓN
  // ------------------------------------------------------
  lastLogin   DateTime? @map("last_login") @db.Timestamptz
  isSuperuser Boolean   @default(false) @map("is_superuser")

  // ------------------------------------------------------
  // DATOS PERSONALES
  // ------------------------------------------------------
  username   String     @unique @db.Citext
  firstName  String     @default("") @map("first_name") @db.VarChar(150)
  lastName   String     @default("") @map("last_name") @db.VarChar(150)
  email      String     @unique @db.Citext
  avatarUrl  String?    @map("avatar_url") @db.VarChar(500)
  avatarType AvatarType @default(DEFAULT_DICEBEAR) @map("avatar_type")

  // ------------------------------------------------------
  // ESTADO E IDENTIDAD INSTITUCIONAL
  // ------------------------------------------------------
  isStaff         Boolean    @default(false) @map("is_staff")
  status          UserStatus @default(PENDING)
  dateJoined      DateTime   @default(now()) @map("date_joined") @db.Timestamptz
  institutionalId String     @unique @map("institutional_id") @db.Citext
  role            UserRole   @default(STUDENT)
  isVerified      Boolean    @default(false) @map("is_verified")

  // ------------------------------------------------------
  // IDENTIDAD NACIONAL (PERÚ)
  // Opcional para estudiantes; obligatorio para JURY / ADMIN y docentes
  // (validado por el IdentityProvider RENIEC/PIDE en service).
  // ------------------------------------------------------
  documentType   DocumentType? @map("document_type")
  documentNumber String?       @map("document_number") @db.VarChar(20)

  // ------------------------------------------------------
  // SCOPE ADMINISTRATIVO (multi-sede). Solo aplica a rol = ADMIN.
  //   * ORG:     cubre toda la organización. region_id NULL.
  //   * REGION:  cubre todas las sedes de region_id. siteIds derivados
  //             por JOIN contra organization_sites.region_id.
  //   * SITE:    cubre N sedes concretas listadas en user_site_assignments.
  // Para STUDENT/TEACHER/JURY/SUPERADMIN: scope_level = NULL.
  // ------------------------------------------------------
  scopeLevel UserScopeLevel? @map("scope_level")
  regionId   String?         @map("region_id") @db.Uuid

  // ------------------------------------------------------
  // TENANT Y CONTEXTO ACADÉMICO
  // ------------------------------------------------------
  organizationId String? @map("organization_id") @db.Uuid
  facultyId      String? @map("faculty_id") @db.Uuid
  programId      String? @map("program_id") @db.Uuid
  careerId       String? @map("career_id") @db.Uuid

  // ------------------------------------------------------
  // PERFILES ESPECÍFICOS
  // ------------------------------------------------------
  // Estudiantes
  currentCycle      Int?    @map("current_cycle")
  admissionPeriodId String? @map("admission_period_id") @db.Uuid

  // Docentes
  specialty  String? @db.VarChar(255)
  department String? @db.VarChar(255)

  // ------------------------------------------------------
  // AUDITORÍA DE CAMBIOS (Auto-relaciones)
  // ------------------------------------------------------
  lastRoleChangeById   String?   @map("last_role_change_by") @db.Uuid
  lastRoleChangeAt     DateTime? @map("last_role_change_at") @db.Timestamptz
  lastStatusChangeById String?   @map("last_status_change_by") @db.Uuid
  lastStatusChangeAt   DateTime? @map("last_status_change_at") @db.Timestamptz
  statusChangeReason   String?   @map("status_change_reason") @db.VarChar(255)

  // ------------------------------------------------------
  // 2FA Y SEGURIDAD
  // ------------------------------------------------------
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?   @map("two_factor_secret") @db.VarChar(500)
  twoFactorBackupCodes Json      @default("[]") @map("two_factor_backup_codes")
  mustChangePassword   Boolean   @default(true) @map("must_change_password")
  mustSetup2fa         Boolean   @default(false) @map("must_setup_2fa")
  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz
  passwordChangedAt    DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Auditoría de Sesión
  lastLoginIp        String? @map("last_login_ip") @db.VarChar(45)
  lastLoginUserAgent String? @map("last_login_user_agent") @db.Text
  preferredLocale    String? @map("preferred_locale") @db.VarChar(10)

  // ------------------------------------------------------
  // RELACIONES DIRECTAS
  // ------------------------------------------------------
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  faculty         Faculty?        @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  program         Program?        @relation(fields: [programId], references: [id], onDelete: SetNull)
  admissionPeriod AcademicPeriod? @relation(fields: [admissionPeriodId], references: [id], onDelete: SetNull)
  career          Career?         @relation(fields: [careerId], references: [id], onDelete: SetNull)
  region          Region?         @relation("UserRegion", fields: [regionId], references: [id], onDelete: SetNull)

  // Auto-relaciones de auditoría
  lastRoleChangeBy   User?  @relation("RoleChangeAudit", fields: [lastRoleChangeById], references: [id], onDelete: SetNull)
  lastStatusChangeBy User?  @relation("StatusChangeAudit", fields: [lastStatusChangeById], references: [id], onDelete: SetNull)
  roleChangedUsers   User[] @relation("RoleChangeAudit")
  statusChangedUsers User[] @relation("StatusChangeAudit")

  // ------------------------------------------------------
  // RELACIONES INVERSAS DEL SISTEMA
  // ------------------------------------------------------
  refreshTokens           RefreshToken[]
  oneTimeTokens           OneTimeToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  activationTokens        ActivationToken[]
  voterRegistries         VoterRegistry[]
  auditLogs               AuditLog[]
  votingAccessTokens      VotingAccessToken[]
  createdElections        Election[]               @relation("CreatedElections")
  candidacies             Candidacy[]
  notifications           Notification[]
  reviewedOrgRequests     OrganizationRequest[]    @relation("OrgRequestReviewer")
  votingSessions          VotingSession[]
  votes                   Vote[]
  ratings                 Rating[]     @relation("JurorRatings")
  voterRegistryClaims     VoterRegistryClaim[]     @relation("UserClaims")
  reviewedVoterRegistryClaims VoterRegistryClaim[] @relation("ReviewerClaims")
  mediaFiles              media_files[]
  advisorForCandidacies   Candidacy[]              @relation("AdvisorCandidacies")
  juryAssignments         JuryAssignment[]         @relation("JuryAssignments")
  teachingAssignments     TeachingAssignment[]     @relation("TeachingAssignments")
  teacherEvaluationsByStudent TeacherEvaluation[]  @relation("TeacherEvaluationsByStudent")
  teacherEvaluationsForTeacher TeacherEvaluation[] @relation("TeacherEvaluationsForTeacher")
  assignedJuryAssignments JuryAssignment[]         @relation("JuryAssignmentsBy")
  objectionsFiled         CandidacyObjection[]     @relation("ObjectionFiler")
  objectionsReviewed      CandidacyObjection[]     @relation("ObjectionReviewer")

  // Proyectos de feria (propietario / revisor / participante)
  createdProjects         Project[]                @relation("CreatedProjects")
  reviewedProjects        Project[]                @relation("ReviewedProjects")
  projectMemberships      ProjectMember[]          @relation("ProjectMemberships")

  // Multi-sede: asignaciones de scope SITE (N:M con OrganizationSite)
  siteAssignments        UserSiteAssignment[]     @relation("UserSiteAssignments")
  siteAssignmentsGranted UserSiteAssignment[]     @relation("UserSiteAssignmentsGrantedBy")
  // Jurados de FERIAS (rol global JURY; participación formal en una feria).
  // Relación exclusiva del dominio de ferias — no se mezcla con
  // juryAssignments (dominio electoral de elections/candidacies).
  fairJuryAssignments         FairJuryAssignment[] @relation("FairJuryAssignments")
  assignedFairJuryAssignments FairJuryAssignment[] @relation("FairJuryAssignmentsBy")

  // Evaluaciones de proyectos de feria realizadas por este usuario como JURY.
  fairEvaluations FairEvaluation[] @relation("FairEvaluations")

  // Participación en la votación anónima de ferias (este jurado ya votó).
  fairVoteParticipations FairVoteParticipation[] @relation("FairVoteParticipations")

  // "Me gusta" y comentarios dejados por este usuario como jurado de feria.
  fairProjectLikes    FairProjectLike[]    @relation("FairProjectLikes")
  fairProjectComments FairProjectComment[] @relation("FairProjectComments")

  // Publicaciones de resultados de ferias realizadas por este usuario (ADMIN).
  fairResultPublications FairResultPublication[] @relation("FairResultPublications")

  // Declaraciones de imparcialidad firmadas por este usuario como JURY de ferias.
  fairJuryDeclarations FairJuryDeclaration[] @relation("FairJuryDeclarations")

  // Certificados oficiales emitidos a este usuario (participación / ganador).
  certificates         Certificate[]

  // ------------------------------------------------------
  // ÍNDICES
  // ------------------------------------------------------
  @@index([organizationId], map: "idx_users_organization")
  @@index([role], map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@index([institutionalId], map: "idx_users_institutional_id")
  @@index([documentNumber], map: "idx_users_document_number")
  @@index([scopeLevel], map: "idx_users_scope_level")
  @@index([regionId], map: "idx_users_region")
  @@unique([organizationId, documentNumber], map: "uq_users_organization_document")
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash") @db.VarChar(255)
  deviceInfo Json     @default("{}") @map("device_info")
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_refresh_tokens_user")
  @@index([userId], map: "idx_refresh_tokens_active")
  @@map("refresh_tokens")
}

model OneTimeToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash") @db.VarChar(255)
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_otp_user_pending")
  @@map("one_time_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique(map: "uq_email_verification_tokens_token_hash") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_email_verification_tokens_user")
  @@map("email_verification_tokens")
}

model ActivationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique(map: "uq_activation_tokens_token_hash") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_activation_tokens_user")
  @@map("activation_tokens")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique(map: "uq_password_reset_tokens_token_hash") @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_password_reset_tokens_user")
  @@map("password_reset_tokens")
}model media_files {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String   @db.Uuid
  filename         String   @db.VarChar(255)
  original_name    String   @db.VarChar(255)
  mime_type        String   @db.VarChar(100)
  size_bytes       Int
  url              String   @db.VarChar(1000)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_media_files_user")
}
