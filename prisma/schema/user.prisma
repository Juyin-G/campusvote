model User {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  password                String?                  @db.VarChar(255)
  authProvider            AuthProviderType         @default(LOCAL) @map("auth_provider")
  googleId                String?                  @unique(map: "uq_users_google_id") @map("google_id") @db.VarChar(255)
  lastLogin               DateTime?                @map("last_login") @db.Timestamptz(6)
  isSuperuser             Boolean                  @default(false) @map("is_superuser")
  username                String                   @unique(map: "uq_users_username") @db.Citext
  firstName               String                   @default("") @map("first_name") @db.VarChar(150)
  lastName                String                   @default("") @map("last_name") @db.VarChar(150)
  email                   String                   @unique(map: "uq_users_email") @db.Citext
  isStaff                 Boolean                  @default(false) @map("is_staff")
  isActive                Boolean                  @default(true) @map("is_active")
  dateJoined              DateTime                 @default(now()) @map("date_joined") @db.Timestamptz(6)
  institutionalId         String                   @unique(map: "uq_users_institutional_id") @map("institutional_id") @db.Citext
  role                    UserRole                 @default(STUDENT)
  isVerified              Boolean                  @default(false) @map("is_verified")
  organizationId          String?                  @map("organization_id") @db.Uuid
  twoFactorEnabled        Boolean                  @default(false) @map("two_factor_enabled")
  twoFactorSecret         String?                  @map("two_factor_secret") @db.VarChar(255)
  twoFactorBackupCodes    Json                     @default("[]") @map("two_factor_backup_codes")
  mustChangePassword      Boolean                  @default(true) @map("must_change_password")
  failedLoginAttempts     Int                      @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?                @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt       DateTime                 @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  audit_logs              audit_logs[]
  candidacies             candidacies[]
  elections               elections[]
  emailVerificationTokens EmailVerificationToken[]
  one_time_tokens         one_time_tokens[]
  organization_requests   organization_requests[]
  passwordResetTokens     PasswordResetToken[]
  organization            organizations?           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  voter_registries        voter_registries[]
  votes                   votes[]
  voting_sessions         voting_sessions[]

  @@index([dateJoined(sort: Desc)], map: "idx_users_date_joined_desc")
  @@index([organizationId], map: "idx_users_organization_id")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique(map: "uq_email_verification_tokens_token_hash") @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_email_verification_tokens_user")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique(map: "uq_password_reset_tokens_token_hash") @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "idx_password_reset_tokens_user")
  @@map("password_reset_tokens")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
  ELECTORAL_COMMISSION
  OBSERVER

  @@map("user_role")
}

enum AuthProviderType {
  LOCAL
  GOOGLE

  @@map("auth_provider_type")
}
