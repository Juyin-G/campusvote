// =====================================================================
// MÓDULO DE VOTACIÓN Y ESCRUTINIO
// Modelos en PascalCase con campos camelCase (patrón del resto del schema)
// =====================================================================

// ─────────────────────────────────────────────────────────────
// Tally (escrutinio por cargo y opción)
// Tabla física: tallies
// ─────────────────────────────────────────────────────────────

model Tally {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId String     @map("election_id") @db.Uuid
  positionId String     @map("position_id") @db.Uuid
  optionId   String     @map("option_id") @db.Uuid
  votesCount Int        @default(0) @map("votes_count")
  stake      StakeType? @map("stake")
  updatedAt  DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Relaciones
  election     Election     @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ballotOption BallotOption @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  position     Position     @relation(fields: [positionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([electionId, positionId, optionId, stake], map: "uq_tallies_election_position_option_stake")
  @@index([positionId], map: "idx_tallies_position")
  @@map("tallies")
}

// ─────────────────────────────────────────────────────────────
// VotingSession (sesión de votación de un elector)
// Tabla física: voting_sessions
// ─────────────────────────────────────────────────────────────

model VotingSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId   String    @map("election_id") @db.Uuid
  voterId      String    @map("voter_id") @db.Uuid
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  ipAddress    String?   @map("ip_address") @db.Inet
  userAgent    String?   @map("user_agent")
  isSuccessful Boolean   @default(false) @map("is_successful")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  // Relaciones
  vote     Vote?    @relation("VoteSession")
  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User     @relation(fields: [voterId], references: [id], onUpdate: NoAction)

  @@index([electionId], map: "idx_voting_sessions_election")
  @@index([voterId], map: "idx_voting_sessions_voter")
  @@map("voting_sessions")
}

// ─────────────────────────────────────────────────────────────
// Vote (voto emitido)
// Tabla física: votes
// ─────────────────────────────────────────────────────────────

model Vote {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId       String          @map("election_id") @db.Uuid
  voterId          String          @map("voter_id") @db.Uuid
  sessionId        String          @unique @map("session_id") @db.Uuid
  castAt           DateTime        @default(now()) @map("cast_at") @db.Timestamptz(6)
  receiptCode      String          @unique @map("receipt_code") @db.VarChar(64)
  encryptedPayload String          @map("encrypted_payload")
  payloadHash      String          @map("payload_hash") @db.VarChar(128)
  voteSelections   VoteSelection[]
  election         Election        @relation(fields: [electionId], references: [id], onUpdate: NoAction)
  votingSession    VotingSession   @relation("VoteSession", fields: [sessionId], references: [id], onUpdate: NoAction)
  user             User            @relation(fields: [voterId], references: [id], onUpdate: NoAction)

  @@unique([electionId, voterId], map: "uq_votes_election_voter")
  @@index([castAt(sort: Desc)], map: "idx_votes_cast_at")
  @@index([electionId], map: "idx_votes_election")
  @@index([payloadHash], map: "idx_votes_payload_hash")
  @@index([voterId], map: "idx_votes_voter")
  @@map("votes")
}

// ─────────────────────────────────────────────────────────────
// VoteSelection (selección por cargo de un voto)
// Tabla física: vote_selections
// ─────────────────────────────────────────────────────────────

model VoteSelection {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voteId         String       @map("vote_id") @db.Uuid
  ballotOptionId String       @map("ballot_option_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  ballotOption   BallotOption @relation(fields: [ballotOptionId], references: [id], onUpdate: NoAction)
  vote           Vote         @relation(fields: [voteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([voteId, ballotOptionId], map: "uq_vote_selections_vote_option")
  @@index([ballotOptionId], map: "idx_vote_selections_ballot_option")
  @@index([voteId], map: "idx_vote_selections_vote")
  @@map("vote_selections")
}

// ─────────────────────────────────────────────────────────────
// ElectionResult (acta consolidada de resultados)
// Tabla física: election_results
// ─────────────────────────────────────────────────────────────

model ElectionResult {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId        String    @unique @map("election_id") @db.Uuid
  totalVoters       Int       @default(0) @map("total_voters")
  totalVotesCast    Int       @default(0) @map("total_votes_cast")
  turnoutPercentage Decimal   @default(0) @map("turnout_percentage") @db.Decimal(5, 2)
  blankVotes        Int       @default(0) @map("blank_votes")
  nullVotes         Int       @default(0) @map("null_votes")
  certifiedAt       DateTime? @map("certified_at") @db.Timestamptz
  publishedAt       DateTime? @map("published_at") @db.Timestamptz
  reportPdf         String?   @map("report_pdf") @db.VarChar(500)
  reportHash        String?   @map("report_hash") @db.VarChar(64)
  reportSignature   String?   @map("report_signature") @db.Text

  // DESEMPATE (F7): resolución registrada, nunca mezclada con conteos.
  tieBreakApplied  Boolean   @default(false) @map("tie_break_applied")
  tieBreakWinnerId String?   @map("tie_break_winner_id") @db.Uuid
  tieBreakAt       DateTime? @map("tie_break_at") @db.Timestamptz

  // CONFIG DE ESCRUTINIO APLICADA (F2/F6): pesos, quórum por estamento,
  // y ranking final de ferias (jurados + voto popular) derivado.
  weightedConfig Json? @map("weighted_config")
  fairRanking    Json? @map("fair_ranking")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  // Relaciones
  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("election_results")
}
