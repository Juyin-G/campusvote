// ENUMS

enum ElectionProcessType {
  VOTE
  FAIR
  FEEDBACK
  FORM

  @@map("election_process_type")
}

enum CandidacyStatusType {
  PENDING
  APPROVED
  REJECTED

  @@map("candidacy_status_type")
}

enum ElectionScopeType {
  UNIVERSITY
  FACULTY
  PROGRAM

  @@map("election_scope_type")
}

enum ElectionStatusType {
  DRAFT
  SCHEDULED
  OPEN
  CLOSED
  CERTIFIED
  PUBLISHED

  @@map("election_status_type")
}

enum CandidacyDocumentType {
  WORK_PLAN
  CV
  ID_CARD
  OTHER

  @@map("candidacy_document_type")
}

// MODELOS

model Election {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String              @db.VarChar(255)
  description        String              @default("") @db.Text
  processType        ElectionProcessType @default(VOTE) @map("process_type")
  scopeType          ElectionScopeType   @map("scope_type")
  periodId           String              @map("period_id") @db.Uuid
  facultyId          String?             @map("faculty_id") @db.Uuid
  programId          String?             @map("program_id") @db.Uuid
  startAt            DateTime            @map("start_at") @db.Timestamptz
  endAt              DateTime            @map("end_at") @db.Timestamptz
  status             ElectionStatusType  @default(DRAFT)
  createdBy          String              @map("created_by") @db.Uuid
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  formStructure      Json?               @map("form_structure")
  isAnonymousAllowed Boolean             @default(false) @map("is_anonymous_allowed")

  // Relaciones internas
  period             AcademicPeriod      @relation(fields: [periodId], references: [id], onDelete: Restrict)
  faculty            Faculty?            @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  program            Program?            @relation(fields: [programId], references: [id], onDelete: Restrict)
  creator            User                @relation("CreatedElections", fields: [createdBy], references: [id], onDelete: Restrict)
  positions          Position[]
  candidateLists     CandidateList[]
  candidacies        Candidacy[]
  electionRule       ElectionRule?

  // Relaciones con otros módulos (audit, voting, ballots)
  ballots            Ballot[]
  auditLogs          AuditLog[]
  votingAccessTokens VotingAccessToken[]

  @@index([status], map: "idx_elections_status")
  @@index([periodId], map: "idx_elections_period")
  @@index([facultyId], map: "idx_elections_faculty")
  @@index([programId], map: "idx_elections_program")
  @@index([createdBy], map: "idx_elections_created_by")
  @@index([startAt, endAt], map: "idx_elections_active_window")
  @@map("elections")
}

model Position {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId  String   @map("election_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.Text
  seats       Int      @default(1) @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  election        Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidacies     Candidacy[]
  ballotPositions BallotPosition[]

  @@unique([electionId, name], map: "uq_positions_election_name")
  @@unique([id, electionId], map: "uq_positions_id_election")
  @@index([electionId], map: "idx_positions_election_id")
  @@map("positions")
}

model CandidateList {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId  String   @map("election_id") @db.Uuid
  name        String   @db.VarChar(120)
  acronym     String?  @db.VarChar(20)
  motto       String?  @db.VarChar(255)
  logo        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  election    Election    @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidacies Candidacy[]

  @@unique([electionId, name], map: "uq_candidate_lists_election_name")
  @@unique([electionId, acronym], map: "uq_candidate_lists_election_acronym")
  @@unique([id, electionId], map: "uq_candidate_lists_id_election")
  @@index([electionId], map: "idx_candidate_lists_election_id")
  @@map("candidate_lists")
}

model Candidacy {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId      String              @map("election_id") @db.Uuid
  candidateListId String              @map("candidate_list_id") @db.Uuid
  positionId      String?             @map("position_id") @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  status          CandidacyStatusType @default(PENDING) @map("status")
  orderIndex      Int                 @default(1) @map("order_index") @db.SmallInt
  isPrincipal     Boolean             @default(true) @map("is_principal")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  election      Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidateList CandidateList       @relation(fields: [candidateListId, electionId], references: [id, electionId], onDelete: Cascade)
  position      Position?           @relation(fields: [positionId, electionId], references: [id, electionId], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents     CandidacyDocument[]

  @@unique([electionId, userId], map: "uq_candidacies_election_user")
  @@unique([candidateListId, positionId, orderIndex], map: "uq_candidacies_list_position_order")
  @@index([userId], map: "idx_candidacies_user_id")
  @@index([candidateListId], map: "idx_candidacies_candidate_list_id")
  @@index([positionId], map: "idx_candidacies_position_id")
  @@map("candidacies")
}

model ElectionRule {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId           String   @unique @map("election_id") @db.Uuid
  minTurnoutPercentage Decimal  @default(0) @map("min_turnout_percentage") @db.Decimal(5, 2)
  allowBlankVote       Boolean  @default(true) @map("allow_blank_vote")
  allowNullVote        Boolean  @default(true) @map("allow_null_vote")
  maxVotesPerPosition  Int      @default(1) @map("max_votes_per_position") @db.SmallInt
  requires2fa          Boolean  @default(true) @map("requires_2fa")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  election Election @relation(fields: [electionId], references: [id], onDelete: Cascade)

  @@map("election_rules")
}

model CandidacyDocument {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidacyId   String                @map("candidacy_id") @db.Uuid
  documentType  CandidacyDocumentType @map("document_type")
  fileUrl       String                @map("file_url") @db.Text
  fileHash      String                @map("file_hash") @db.Char(64)
  fileSizeBytes BigInt                @map("file_size_bytes")
  mimeType      String                @map("mime_type") @db.VarChar(100)
  uploadedAt    DateTime              @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relaciones
  candidacy Candidacy @relation(fields: [candidacyId], references: [id], onDelete: Cascade)

  @@unique([candidacyId, documentType], map: "uq_candidacy_documents_type")
  @@index([candidacyId], map: "idx_candidacy_documents_candidacy")
  @@map("candidacy_documents")
}