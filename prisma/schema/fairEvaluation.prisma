// ============================================================
// RÚBRICAS DE EXPOSICIÓN Y VOTACIÓN DE JURADO EN FERIAS
// ============================================================
// Modelo refactorizado (PASO 8 — ver migration 012):
//
//   A) RÚBRICA DE EXPOSICIÓN (CHECKLIST) — registrada en fairEvaluations:
//        Fair ── FairRubric ── RubricCriterion (booleano, sin score num.)
//        Fair ── FairEvaluation (hoja 1 por feria+proyecto+jurado)
//                    ── FairEvaluationDetail (checked true/false por criterio)
//        submitted_at: NULL = pendiente, NOT NULL = finalizada.
//
//   B) VOTACIÓN ANÓNIMA (módulo fairVoting) — registrada acá para reusar
//      la FK compuesta (fair_id) y (fair_id, project_id) ya disponibles:
//        Fair ── FairVoteParticipation (UNIQUE fair_id, jury_user_id)
//        Fair ── FairVote (sin jury_user_id en la fila → anonimato real)
//
//   La rúbrica NO decide ganadores. La VOTACIÓN (FairVote) sí.
//
// Reglas:
//   - UNA rúbrica por feria (UNIQUE fair_id). Configurable solo en DRAFT.
//   - El JURY (no el expositor) responde. Los criterios NO marcados son
//     respuestas válidas (se persiste una fila por criterio con checked=false).
//   - UNIQUE (fair_id, project_id, jury_user_id) en fair_evaluations: una
//     hoja por (feria, proyecto, jurado).
//   - UNIQUE (evaluation_id, criterion_id) en fair_evaluation_details.
//   - UNIQUE (fair_id, jury_user_id) en fair_vote_participation: un voto
//     por jurado y feria (anti doble-voto concurrente).
//   - fair_votes NO tiene FK a users → anonimato. Se enlaza al jurado
//     únicamente vía fair_vote_participation (separación conceptual).
// ============================================================

model FairRubric {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fairId      String  @unique(map: "uq_fair_rubrics_fair") @map("fair_id") @db.Uuid
  name        String  @db.VarChar(200)
  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  fair        Fair              @relation(fields: [fairId], references: [id], onDelete: Restrict)
  criteria    RubricCriterion[]
  evaluations FairEvaluation[]

  @@map("fair_rubrics")
}

// Criterio de la rúbrica de exposición de una feria.
// CHECKLIST: NO score numérico. Solo boolean (checked en la respuesta).
// is_active permite desactivar un criterio sin perder el histórico de respuestas.
model RubricCriterion {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rubricId    String  @map("rubric_id") @db.Uuid
  name        String  @db.VarChar(200)
  description String? @db.Text
  position    Int     @db.SmallInt
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  rubric            FairRubric             @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  evaluationDetails FairEvaluationDetail[]

  @@unique([rubricId, position], map: "uq_rubric_criteria_rubric_position")
  @@index([rubricId], map: "idx_rubric_criteria_rubric")
  @@map("rubric_criteria")
}

// HOJA de respuestas de un JURY a un proyecto APPROVED de una feria.
// UNA hoja por (feria, proyecto, jurado).
// submitted_at: NULL = pendiente, NOT NULL = finalizada (inmutable).
// NO almacena scores: el "resultado" es el conjunto de FairEvaluationDetail.
model FairEvaluation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fairId      String    @map("fair_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  juryUserId  String    @map("jury_user_id") @db.Uuid
  rubricId    String    @map("rubric_id") @db.Uuid
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  fair    Fair                   @relation(fields: [fairId], references: [id], onDelete: Restrict)
  project Project                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  jury    User                   @relation("FairEvaluations", fields: [juryUserId], references: [id], onDelete: Restrict)
  rubric  FairRubric             @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  details FairEvaluationDetail[]

  @@unique([fairId, projectId, juryUserId], map: "uq_fair_evaluations_fair_project_jury")
  @@index([juryUserId], map: "idx_fair_evaluations_jury")
  @@index([projectId], map: "idx_fair_evaluations_project")
  @@index([rubricId], map: "idx_fair_evaluations_rubric")
  @@map("fair_evaluations")
}

// Respuesta individual de un criterio: CHECKLIST puro (booleano).
// NO score numérico: el JURY marca o desmarca cada criterio de exposición.
model FairEvaluationDetail {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evaluationId String  @map("evaluation_id") @db.Uuid
  criterionId  String  @map("criterion_id") @db.Uuid
  rubricId     String  @map("rubric_id") @db.Uuid
  checked      Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  evaluation FairEvaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId], map: "uq_fair_evaluation_details_eval_criterion")
  @@index([criterionId], map: "idx_fair_evaluation_details_criterion")
  @@map("fair_evaluation_details")
}

// =====================================================================
// VOTACIÓN ANÓNIMA DE JURADO EN FERIAS (módulo fairVoting)
// =====================================================================

// Participación: indica "este jurado ya votó en esta feria".
// NO guarda el proyecto votado (eso vive solo en fair_votes).
// Inmutable: no se puede UPDATE ni DELETE (voto definitivo).
model FairVoteParticipation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fairId     String   @map("fair_id") @db.Uuid
  juryUserId String   @map("jury_user_id") @db.Uuid
  votedAt    DateTime @default(now()) @map("voted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  fair Fair @relation(fields: [fairId], references: [id], onDelete: Restrict)
  jury User @relation("FairVoteParticipations", fields: [juryUserId], references: [id], onDelete: Restrict)

  @@unique([fairId, juryUserId], map: "uq_fair_vote_participation_fair_jury")
  @@index([juryUserId], map: "idx_fair_vote_participation_jury")
  @@index([fairId], map: "idx_fair_vote_participation_fair")
  @@map("fair_vote_participation")
}

// Voto anónimo. SIN FK directa al jurado → anonimato real.
// El comprobante técnico (receipt_code) lo genera el service con
// crypto.randomBytes. Sirve para verificación pública futura.
model FairVote {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fairId      String @map("fair_id") @db.Uuid
  projectId   String @map("project_id") @db.Uuid
  receiptCode String @unique @map("receipt_code") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  fair    Fair    @relation(fields: [fairId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([fairId, receiptCode], map: "uq_fair_votes_receipt")
  @@index([fairId], map: "idx_fair_votes_fair")
  @@index([projectId], map: "idx_fair_votes_project")
  @@map("fair_votes")
}
