// ============================================================
// MÓDULO DE EXPLORACIÓN DEL JURADO — fairEngagement
// ============================================================
// COMPLETAMENTE SEPARADO de la rúbrica (fairEvaluations) y de la
// votación oficial (fairVoting). NO participa en ranking ni en
// cálculo del ganador.
//
//   1. RATING / EXPLORACIÓN  (este módulo) — likes + comentarios.
//   2. RÚBRICA                (fairEvaluations) — checklist.
//   3. VOTACIÓN OFICIAL       (fairVoting) — voto anónimo.
//
// Reglas:
//   - Solo jurados FORMALMENTE ASIGNADOS a la feria pueden interactuar
//     (FK compuesta fair_id, jury_user_id → fair_jury_assignments).
//   - Solo en ferias OPEN y proyectos APPROVED (trigger BD).
//   - UN jurado puede dar Me gusta UNA vez por proyecto (UNIQUE).
//   - Comentarios siempre anónimos para estudiantes (controlado
//     por el backend vía is_anonymous).
//   - Hitos (5, 10, 25, 50, 100) notifican UNA vez por proyecto/umbral
//     (dedupe vía fair_project_like_milestones).

// ── "Me gusta" del jurado a un proyecto ─────────────────────────────
model FairProjectLike {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fairId       String   @map("fair_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  juryUserId   String   @map("jury_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  fair     Fair    @relation(fields: [fairId], references: [id], onDelete: Restrict)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  jury     User    @relation("FairProjectLikes", fields: [juryUserId], references: [id], onDelete: Restrict)

  @@unique([projectId, juryUserId], map: "uq_fair_project_likes_project_jury")
  @@index([fairId], map: "idx_fair_project_likes_fair")
  @@index([projectId], map: "idx_fair_project_likes_project")
  @@index([juryUserId], map: "idx_fair_project_likes_jury")
  @@map("fair_project_likes")
}

// ── Comentarios / retroalimentación del jurado ──────────────────────
model FairProjectComment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fairId       String   @map("fair_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  juryUserId   String   @map("jury_user_id") @db.Uuid
  comment      String   @db.Text
  isAnonymous  Boolean  @default(true) @map("is_anonymous")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  fair     Fair    @relation(fields: [fairId], references: [id], onDelete: Restrict)
  project  Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  jury     User    @relation("FairProjectComments", fields: [juryUserId], references: [id], onDelete: Restrict)

  @@index([fairId], map: "idx_fair_project_comments_fair")
  @@index([projectId], map: "idx_fair_project_comments_project")
  @@index([juryUserId], map: "idx_fair_project_comments_jury")
  @@map("fair_project_comments")
}

// ── Dedupe de notificaciones por hito de Me gusta ───────────────────
// Marca qué umbrales ya fueron notificados para un proyecto. Así nunca
// se duplican notificaciones: si el proyecto pasa de 10 a 11 likes,
// el servicio consulta aquí si el milestone=10 ya está marcado.
model FairProjectLikeMilestone {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  milestone   Int      @db.SmallInt
  notifiedAt  DateTime @default(now()) @map("notified_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, milestone], map: "uq_fair_project_like_milestones_project_milestone")
  @@index([projectId], map: "idx_fair_project_like_milestones_project")
  @@map("fair_project_like_milestones")
}
