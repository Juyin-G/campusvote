// 1. FACULTADES

model Faculty {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(150)
  code      String   @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  programs Program[]

  @@map("faculties")
}


// 2. PROGRAMAS ACADÉMICOS

model Program {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId String   @map("faculty_id") @db.Uuid
  name      String   @db.VarChar(150)
  code      String   @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  faculty         Faculty         @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  voterRegistries VoterRegistry[]

  @@unique([facultyId, name], name: "uq_programs_faculty_name")
  @@map("programs")
}


// 3. PERÍODOS ACADÉMICOS

model AcademicPeriod {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(50)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  voterRegistries VoterRegistry[]

  @@map("academic_periods")
}


// 4. PADRÓN ELECTORAL (VOTER REGISTRY)

model VoterRegistry {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  programId         String   @map("program_id") @db.Uuid
  periodId          String   @map("period_id") @db.Uuid
  semester          Int      @db.SmallInt
  isEligible        Boolean  @default(true) @map("is_eligible")
  eligibilityReason String?  @map("eligibility_reason") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  program        Program        @relation(fields: [programId], references: [id], onDelete: Restrict)
  academicPeriod AcademicPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([userId, periodId], name: "uq_voter_registries_user_period")
  @@map("voter_registries")
}