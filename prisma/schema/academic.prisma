
// FACULTADES
 
model Faculty {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique @db.VarChar(150)
  code      String    @unique @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  programs  Program[] // Relación 1:N con Programas

  @@map("faculties")
}

// PROGRAMAS ACADÉMICOS

model Program {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facultyId String    @map("faculty_id") @db.Uuid
  name      String    @db.VarChar(150)
  code      String    @unique @db.VarChar(20)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  faculty         Faculty         @relation(fields: [facultyId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  voterRegistries VoterRegistry[]

  @@unique([facultyId, name], map: "uq_programs_faculty_name")
  @@index([facultyId], map: "idx_programs_faculty_id")
  @@map("programs")
}

// PERIODOS ACADÉMICOS

model AcademicPeriod {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @db.VarChar(50)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  voterRegistries VoterRegistry[]

  @@index([isActive], map: "idx_academic_periods_is_active")
  @@index([startDate, endDate], map: "idx_academic_periods_dates")
  @@map("academic_periods")
}

// PADRÓN ELECTORAL (Voter Registries)

model VoterRegistry {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  programId         String   @map("program_id") @db.Uuid
  periodId          String   @map("period_id") @db.Uuid
  semester          Int      @db.SmallInt
  isEligible        Boolean  @default(true) @map("is_eligible")
  eligibilityReason String?  @map("eligibility_reason") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program        @relation(fields: [programId], references: [id], onUpdate: NoAction, onDelete: Restrict)
  period  AcademicPeriod @relation(fields: [periodId], references: [id], onUpdate: NoAction, onDelete: Restrict)

  @@unique([userId, periodId], map: "uq_voter_registries_user_period")
  @@index([userId], map: "idx_voter_registries_user_id")
  @@index([programId], map: "idx_voter_registries_program_id")
  @@index([periodId], map: "idx_voter_registries_period_id")
  @@index([programId, periodId], map: "idx_voter_registries_program_period")
  @@map("voter_registries")
}