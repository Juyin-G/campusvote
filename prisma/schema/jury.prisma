enum JuryAssignmentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("jury_assignment_status")
}

model JuryAssignment {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  electionId  String              @map("election_id") @db.Uuid
  candidacyId String              @map("candidacy_id") @db.Uuid
  juryId      String              @map("jury_id") @db.Uuid
  status      JuryAssignmentStatus @default(PENDING) @map("status")

  // Voto dirimente del Presidente del Jurado (rompe empates; se registra como
  // resolución en election_results, NO se mezcla con conteos).
  isDiriment          Boolean   @default(false) @map("is_diriment")
  conflictDeclaration Boolean   @default(false) @map("conflict_declaration")
  declaredAt          DateTime? @map("declared_at") @db.Timestamptz
  assignedBy          String    @map("assigned_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relaciones
  election Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  candidacy Candidacy @relation(fields: [candidacyId], references: [id], onDelete: Cascade)
  jury      User      @relation("JuryAssignments", fields: [juryId], references: [id], onDelete: Restrict)
  assigner  User      @relation("JuryAssignmentsBy", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@unique([electionId, candidacyId, juryId], map: "uq_jury_assignments_election_candidacy_jury")
  @@index([juryId], map: "idx_jury_assignments_jury")
  @@index([candidacyId], map: "idx_jury_assignments_candidacy")
  @@map("jury_assignments")
}