# Entorno de PRUEBAS. Copiar como .env.test y rellenar.
#
# Este archivo lo carga tests/setup-db.js antes de levantar la app, así que
# debe contener TODAS las variables que src/config/env.js exige al arrancar.
# Si falta alguna obligatoria, las suites fallan con "FATAL: ... no está
# configurado" antes siquiera de ejecutar un test.

NODE_ENV=test

# Base de datos EXCLUSIVA de pruebas.
# tests/setup-db.js hace DROP SCHEMA public CASCADE sobre ella: nunca apuntes
# esta variable a campusvote_db o perderás los datos de desarrollo.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/campusvote_test?schema=public"

# OBLIGATORIO. env.js lo valida al arrancar: mínimo 32 caracteres y no puede
# ser ninguno de los valores de ejemplo conocidos.
# Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Opcional. Si se define, se le aplican las mismas validaciones que a JWT_SECRET.
# JWT_REFRESH_SECRET=

# Opcional. Los tests interceptan el envío de correo, así que no hace falta
# un SMTP real. Se dejan documentadas por si alguna prueba lo necesitara.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
